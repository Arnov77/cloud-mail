--- a/mail-worker/src/entity/setting.js
+++ b/mail-worker/src/entity/setting.js
@@ -21,6 +21,7 @@ export const setting = sqliteTable('setting', {
 	tgBotToken: text('tg_bot_token').default('').notNull(),
 	tgChatId: text('tg_chat_id').default('').notNull(),
 	tgBotStatus: integer('tg_bot_status').default(1).notNull(),
+	tgThreadId: integer('tg_thread_id').default(0).notNull(),
 	forwardEmail: text('forward_email').default('').notNull(),
 	forwardStatus: integer('forward_status').default(1).notNull(),
 	ruleEmail: text('rule_email').default('').notNull(),
diff --git a/mail-worker/src/init/init.js b/mail-worker/src/init/init.js
index 435dc0a..df3fff3 100644
--- a/mail-worker/src/init/init.js
+++ b/mail-worker/src/init/init.js
@@ -24,11 +24,21 @@ const dbInit = {
 		await this.v3_4DB(c);
 		await this.v3_5DB(c);
 		await this.v3_6DB(c);
+		await this.v3_7DB(c);
 		await userService.initAdmin(c);
 		await settingService.refresh(c);
 		return c.text('success');
 	},
 
+	async v3_7DB(c) {
+		try {
+			// Telegram 通知发到论坛话题：0 = 主聊天（行为 lama）。
+			await c.env.db.prepare(`ALTER TABLE setting ADD COLUMN tg_thread_id INTEGER NOT NULL DEFAULT 0;`).run();
+		} catch (e) {
+			console.warn(`sql skip:${e.message}`);
+		}
+	},
+
 	async v3_6DB(c) {
 		try {
 			// 保留当前的 1（关闭）和 2（开启），只转换旧版的关闭值和刷新间隔。
diff --git a/mail-worker/src/service/telegram-service.js b/mail-worker/src/service/telegram-service.js
index 97760e0..4877498 100644
--- a/mail-worker/src/service/telegram-service.js
+++ b/mail-worker/src/service/telegram-service.js
@@ -46,9 +46,11 @@ const telegramService = {
 
 	async sendEmailToBot(c, email) {
 
-		const { tgBotToken, tgChatId, customDomain, tgMsgTo, tgMsgFrom, tgMsgText } = await settingService.query(c);
+		const { tgBotToken, tgChatId, tgThreadId, customDomain, tgMsgTo, tgMsgFrom, tgMsgText } = await settingService.query(c);
 
 		const tgChatIds = tgChatId.split(',');
+		// ID topik forum Telegram (0 = kirim ke chat utama, perilaku lama).
+		const threadId = Number(tgThreadId) || 0;
 
 		const jwtToken = await jwtUtils.generateToken(c, { emailId: email.emailId })
 
@@ -72,21 +74,35 @@ const telegramService = {
 		}
 
 		await Promise.all(tgChatIds.map(async chatId => {
-			try {
-				const res = await fetch(`https://api.telegram.org/bot${tgBotToken}/sendMessage`, {
+			// Bila threadId diisi, kirim ke topik forum; bila topik tidak
+			// ditemukan (mis. topik dihapus), kirim ulang ke chat utama
+			// supaya notifikasi tidak hilang.
+			const sendOnce = (useThread) => {
+				const body = {
+					chat_id: chatId,
+					parse_mode: 'HTML',
+					text: emailMsgTemplate(email, tgMsgTo, tgMsgFrom, tgMsgText),
+					reply_markup: {
+						inline_keyboard: inlineKeyboard
+					}
+				};
+				if (useThread && threadId) {
+					body.message_thread_id = threadId;
+				}
+				return fetch(`https://api.telegram.org/bot${tgBotToken}/sendMessage`, {
 					method: 'POST',
 					headers: {
 						'Content-Type': 'application/json'
 					},
-					body: JSON.stringify({
-						chat_id: chatId,
-						parse_mode: 'HTML',
-						text: emailMsgTemplate(email, tgMsgTo, tgMsgFrom, tgMsgText),
-						reply_markup: {
-							inline_keyboard: inlineKeyboard
-						}
-					})
+					body: JSON.stringify(body)
 				});
+			};
+			try {
+				let res = await sendOnce(true);
+				if (!res.ok && threadId) {
+					console.error(`转发 Telegram 到话题失败 status: ${res.status} response: ${await res.text()}，重试到主聊天`);
+					res = await sendOnce(false);
+				}
 				if (!res.ok) {
 					console.error(`转发 Telegram 失败 status: ${res.status} response: ${await res.text()}`);
 				}
